# =============================================================================
# SuplAI environment configuration  —  copy to `.env` and fill in real values.
#   cp .env.example .env
# NEVER commit the real .env (it is gitignored).
# =============================================================================

# ---- Supabase (database + optional auth) ------------------------------------
# Dashboard: https://app.supabase.com  ->  Project Settings -> API
# Use the SERVICE ROLE key (server-side only, full access). Keep it secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ---- JWT auth ----------------------------------------------------------------
# Generate a strong random secret, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# REQUIRED. The app refuses to start in production without a non-default value.
JWT_SECRET_KEY=change-me-generate-a-long-random-string
JWT_EXPIRE_HOURS=24
# Optional refresh token lifetime (days)
JWT_REFRESH_EXPIRE_DAYS=7

# ---- Runtime / CORS ----------------------------------------------------------
# "development" relaxes a few guards; set to "production" when deploying.
APP_ENV=development
# Comma-separated list of allowed frontend origins (NO trailing slash, NO "*").
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# External data providers — all FREE tiers, none require a credit card.
# Leave any blank to run that signal in demo/fallback mode (clearly flagged in
# the API response with "source": "fallback").
# =============================================================================

# ---- OpenWeatherMap  (free: 1,000 calls/day) --------------------------------
# Severe weather at supplier/warehouse locations feeds the risk score.
# Sign up + key: https://openweathermap.org/api  (Account -> API keys)
OPENWEATHER_API_KEY=

# ---- OpenStreetMap Nominatim  (free, NO key required) -----------------------
# Geocoding addresses -> lat/lng when adding entities. Usage policy requires a
# descriptive User-Agent with a contact; put your app name + email here.
NOMINATIM_USER_AGENT=suplai/1.0 (your-email@example.com)

# ---- NewsData.io  (free: 200 credits/day) -----------------------------------
# Disruption news feed filtered by keywords/regions.
# Sign up + key: https://newsdata.io  (Dashboard -> API Key)
NEWSDATA_API_KEY=

# ---- ExchangeRate-API  (free tier, NO card required) ------------------------
# Currency volatility for supplier countries as a minor risk factor.
# Sign up + key: https://www.exchangerate-api.com/  (Dashboard)
EXCHANGERATE_API_KEY=

# ---- Frontend (Vite) ---------------------------------------------------------
# Where the frontend reaches the backend. Set in frontend/.env for the client.
# VITE_API_URL=http://127.0.0.1:8000
